classDiagram
    direction LR

    class Quiz {
        -Map responses
        +createAdopterProfile() : AdopterProfile
    }

    class AdopterProfile {
        +String name
        +SpeciesPreference preferredSpecies
        +AgePreference preferredAge
        +HousingType housingType
        +ActivityLevel activityLevel
        +AvailableTime availableTime
        +ExperienceLevel experienceLevel
        +Trait[] preferredTraits
        +HouseholdMember[] household
    }

    class MatchEngine {
        +is_eligible(profile: AdopterProfile, pet: Pet) : boolean
        +calculate_age_score(profile: AdopterProfile, pet: Pet) : float
        +calculate_activity_score(profile: AdopterProfile, pet: Pet) : float
        +calculate_experience_score(profile: AdopterProfile, pet: Pet) : float
        +calculate_trait_score(profile: AdopterProfile, pet: Pet) : float
        +calculate_score(profile: AdopterProfile, pet: Pet) : float
        +get_matches(profile: AdopterProfile, pets: Pet[]) : PetMatch[]
    }

    class Pet {
        +int id
        +String name
        +String pet_image
        +Species species
        +String breed
        +int age
        +ActivityLevel energy_level
        +boolean apartment_friendly
        +ExperienceLevel experience_required
        +Trait[] personality_traits
        +boolean good_with_children
        +boolean good_with_dogs
        +boolean good_with_cats
        +String notes
    }

    class PetMatch {
        +Pet pet
        +float score
        +Trait[] matched_traits
    }

    class RAGService {
        +generate_match_explanation(request: ExplanationRequest) : String
    }

    class ExplanationRequest {
        +AdopterProfile adopter_profile
        +Pet pet
        +Trait[] matched_traits
        +float score
    }

    Quiz --> AdopterProfile : creates
    MatchEngine --> PetMatch : creates ranked matches
    MatchEngine --> Pet : filters and scores
    PetMatch --> Pet : contains
    RAGService ..> ExplanationRequest : uses
    ExplanationRequest --> Pet : includes
    ExplanationRequest --> AdopterProfile : includes
